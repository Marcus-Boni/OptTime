{
  "name": "opt-time-mcp",
  "version": "1.0.1",
  "description": "Servidor MCP do OptSolv Time Tracker \u2014 registre horas, controle o timer e feche a semana direto do seu agente de IA.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opt-time-mcp": "bin/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "optsolv",
    "time-tracking",
    "timesheet",
    "azure-devops"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcus-Boni/OptTime.git",
    "directory": "packages/opt-time-mcp"
  },
  "homepage": "https://opt-time.optsolv.com.br/dashboard/settings/integrations/mcp",
  "bugs": {
    "url": "https://github.com/Marcus-Boni/OptTime/issues"
  }
}
