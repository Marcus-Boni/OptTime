# ─────────────────────────────────────────────────────────────────────────────
# URL pública da aplicação (sem barra final)
# Desenvolvimento: http://localhost:3000
# Produção:        https://your-app.azurewebsites.net
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Banco de Dados (Azure Database for PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Use a connection string copiada do Azure Portal (Connection strings)
# Exemplo:
# postgresql://app_user:password@my-server.postgres.database.azure.com:5432/opt-timer?sslmode=require
DATABASE_URL="postgresql://app_user:password@my-server.postgres.database.azure.com:5432/opt-timer?sslmode=require"

# Opcional: ajuste fino de pool/SSL (recomendado para produção)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_SSL_REJECT_UNAUTHORIZED=true

# ─────────────────────────────────────────────────────────────────────────────
# Better Auth
# BETTER_AUTH_SECRET: string aleatório seguro (min 32 chars)
#   Gerar: openssl rand -base64 32
# BETTER_AUTH_URL: deve ser igual a NEXT_PUBLIC_APP_URL
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="sua-chave-secreta"
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft OAuth (Azure AD)
# Redirect URI a registrar no Azure Portal:
#   https://your-app.azurewebsites.net/api/auth/callback/microsoft
# Tenant ID:
#   diretório Microsoft Entra onde o app registration foi criado
# ─────────────────────────────────────────────────────────────────────────────
MICROSOFT_TENANT_ID="..."
MICROSOFT_CLIENT_ID="..."
MICROSOFT_CLIENT_SECRET="..."

# ─────────────────────────────────────────────────────────────────────────────
# Email transacional (Resend — https://resend.com)
# Em produção: verificar o domínio em resend.com/domains
# e usar um remetente do domínio verificado, ex: noreply@optsolv.com.br
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="OptSolv Time <noreply@optsolv.com.br>"

# ─────────────────────────────────────────────────────────────────────────────
# Chave de criptografia AES-256 dos PATs do Azure DevOps
# OBRIGATÓRIO em produção — deve ser idêntico em todos os deployments para que
# os PATs já gravados no banco possam ser descriptografados corretamente.
# Se não definido, faz fallback para BETTER_AUTH_SECRET.
# ObrigatÃ³rio tambÃ©m em desenvolvimento; nÃ£o existe fallback seguro.
# Gerar: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Cron secret for POST /api/cron/reminders
# Shared between the app and the external scheduler (GitHub Actions, Azure, etc.)
# Generate: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET="*********"

# ─────────────────────────────────────────────────────────────────────────────
# Integration API v1 — App-to-app (M2M) authentication
#
# ENTRA_API_AUDIENCE: App ID URI of the opt-time-api App Registration in Entra.
#   Example: api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   The same MICROSOFT_TENANT_ID already defined above is used for JWKS validation.
#
# WEBHOOK_ENCRYPTION_KEY: not needed — webhook secrets are encrypted with the
#   existing ENCRYPTION_KEY (same AES-256-GCM key used for Azure DevOps PATs).
# ─────────────────────────────────────────────────────────────────────────────
ENTRA_API_AUDIENCE="api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# Integration API v1 — Chave de Integração Padronizada (API Key)
#
# INTEGRATION_KEY: Chave estática padronizada para autenticação serviço-a-serviço (M2M).
#   Caso definida, permite acesso a todos os projetos e horas sem a necessidade de um
#   token do Microsoft Entra ID.
#   Gerar: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
INTEGRATION_KEY=""


# ─────────────────────────────────────────────────────────────────────────────
# TimeBot — Assistente de IA
#
# O TimeBot tenta os provedores nesta ordem e faz failover automático:
#   1. GEMINI_API_KEY     → Google Gemini (https://aistudio.google.com/apikey)
#   2. GROQ_API_KEY       → Groq         (https://console.groq.com/keys)
#   3. OPENROUTER_API_KEY → OpenRouter   (https://openrouter.ai/keys)
#
# Nenhuma chave é obrigatória: sem provedor configurado o assistente opera em
# modo offline determinístico, respondendo com base direta nos dados do banco
# (horas, timesheets, projetos e timer) através das mesmas ferramentas.
#
# IMPORTANTE: todos os modelos usados precisam suportar function calling.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Overrides opcionais de modelo (deixe vazio para usar os padrões)
GEMINI_MODEL="gemini-3.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
